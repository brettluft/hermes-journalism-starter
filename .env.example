BASETEN_API_KEY=
DISCORD_BOT_TOKEN=
DISCORD_ALLOWED_CHANNELS=

# Optional Draft Library public origin. DRAFT_LIBRARY_BASE_URL takes precedence.
# Set a custom HTTPS origin only when needed; otherwise use the Railway public domain.
# DRAFT_LIBRARY_BASE_URL=
# RAILWAY_PUBLIC_DOMAIN=

# Optional authenticated Spacefast publishing. Store real values only in Railway.
# SPACEFAST_TOKEN=
# SPACEFAST_TEAM_ID=

# These are image defaults. Set them only if you want different behavior.
# DISCORD_REQUIRE_MENTION=false
# DISCORD_AUTO_THREAD=false
